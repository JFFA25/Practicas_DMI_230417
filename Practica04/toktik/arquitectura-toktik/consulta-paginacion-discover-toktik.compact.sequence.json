    {
      "id": "append-pages",
      "from": "repository",
      "to": "discover",
      "y": 490,
      "label": "elimina duplicados + agrega",
      "variant": "return"
    },
    {
      "id": "update-feed",
      "from": "discover",
      "to": "interfaz",
      "y": 520,
      "label": "muestra nuevos videos",
      "variant": "return"
